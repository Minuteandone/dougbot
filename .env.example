# Copy to .env, use your own account values, and never commit .env.
BSKY_USERNAME=your-bot-account.delve.town
BSKY_PASSWORD=
PDS_URI=https://pds.delve.town
DELVE_INVITE_CODE=

# Leave this blank to prefer models/qwenity when installed, otherwise
# Qwen/Qwen2.5-0.5B-Instruct from Hugging Face. Set a path/name to override.
DOUGBOT_HANDLE=
DOUGBOT_BASE_MODEL=
DOUGBOT_ADAPTER=adapter
# Leave DOUGBOT_HANDLE/DOUGBOT_TRIGGER blank to detect the account's handle.
DOUGBOT_TRIGGER=

# Public release: watcher replies require approval unless you explicitly opt in.
# Set DOUGBOT_REPLY_MODE=auto for unattended reply publishing.
DOUGBOT_REPLY_MODE=approval
DOUGBOT_ACTION_MODE=approval
DOUGBOT_REPLY_TO_OWN_THREADS=true
DOUGBOT_POLL_SECONDS=45
DOUGBOT_GENERATION_ATTEMPTS=3
DOUGBOT_SHORT_MAX_TOKENS=22
DOUGBOT_THREAD_MAX_TOKENS=90
DOUGBOT_MAX_NEW_TOKENS=100
DOUGBOT_REPETITION_PENALTY=1.18
DOUGBOT_NO_REPEAT_NGRAM=4

# Spontaneous activity is OFF by default for public installs.
# To opt in, set ENABLED=true and choose approval or auto explicitly.
# Other options are explained in SPONTANEOUS_SETTINGS.env.
DOUGBOT_SPONTANEOUS_ENABLED=false
DOUGBOT_SPONTANEOUS_MODE=approval
DOUGBOT_SPONTANEOUS_COOLDOWN_SECONDS=600
DOUGBOT_SPONTANEOUS_CHANCE=0.06
DOUGBOT_SPONTANEOUS_POST_CHANCE=0.35
DOUGBOT_RANDOM_REPLY_HALF_LIFE_MINUTES=30
DOUGBOT_RANDOM_REPLY_MAX_AGE_HOURS=24
DOUGBOT_SPONTANEOUS_POOL_LIMIT=60
DOUGBOT_SPONTANEOUS_POST_MAX_TOKENS=70
