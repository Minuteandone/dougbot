# Add these to .env only if you want to override the v3 defaults.
# Replies generated by the watcher are automatic by default in v3.
DOUGBOT_REPLY_MODE=auto
# Manual root posts/profile/join actions still require approval by default.
DOUGBOT_ACTION_MODE=approval
DOUGBOT_REPLY_TO_OWN_THREADS=true
DOUGBOT_GENERATION_ATTEMPTS=3
DOUGBOT_SHORT_MAX_TOKENS=34
DOUGBOT_THREAD_MAX_TOKENS=90
DOUGBOT_MAX_NEW_TOKENS=100
DOUGBOT_REPETITION_PENALTY=1.18
DOUGBOT_NO_REPEAT_NGRAM=4
