# Dougbot v5 spontaneous activity add-on
# Copy any values you want to change into your existing .env.

# Master switch. Public releases start with spontaneous activity disabled.
# Change to true to enable it after setting a posting mode.
DOUGBOT_SPONTANEOUS_ENABLED=false

# Minimum seconds between spontaneous actions. This persists across restarts.
DOUGBOT_SPONTANEOUS_COOLDOWN_SECONDS=600

# Chance checked once per normal watcher poll AFTER the cooldown expires.
# 0.06 with the normal 45s poll works out to roughly one action every
# 20-25 minutes on average including the cooldown.
DOUGBOT_SPONTANEOUS_CHANCE=0.06

# When a spontaneous action happens, chance that it is a standalone post.
# The remainder is a random reply. 0.35 = 35% post / 65% reply.
DOUGBOT_SPONTANEOUS_POST_CHANCE=0.35

# Approval is the public default. Set auto ONLY if you explicitly want
# Dougbot to publish spontaneous actions without confirming each one.
DOUGBOT_SPONTANEOUS_MODE=approval

# Recent-post weighting for random replies. A post twice as old as this
# is roughly one quarter the weight of a brand-new post.
DOUGBOT_RANDOM_REPLY_HALF_LIFE_MINUTES=30

# Ignore timestamped posts older than this. Set 0 for no age cutoff.
DOUGBOT_RANDOM_REPLY_MAX_AGE_HOURS=24

# Fetch at least this many town-feed entries so random replies have a pool.
DOUGBOT_SPONTANEOUS_POOL_LIMIT=60

# Token budget for root posts generated by Dougbot.
DOUGBOT_SPONTANEOUS_POST_MAX_TOKENS=70
